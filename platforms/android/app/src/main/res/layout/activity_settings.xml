<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GSR Capture Settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Camera Settings Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:padding="8dp" />

        <!-- Camera Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera Type:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/cameraTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Capture Stage -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture Stage:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/captureStageSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- FPS Setting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frame Rate (FPS):"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/fpsSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/fpsValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 fps"
                android:layout_marginStart="16dp"
                android:minWidth="60dp" />
        </LinearLayout>

        <!-- Resolution -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resolution:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/resolutionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Video Quality -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Video Quality:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/videoQualitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Camera Parameters Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera Parameters"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:padding="8dp" />

        <!-- Exposure -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exposure Compensation:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/exposureSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exposureValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 EV"
                android:layout_marginStart="16dp"
                android:minWidth="60dp" />
        </LinearLayout>

        <!-- ISO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ISO Sensitivity:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/isoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/isoValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISO 800"
                android:layout_marginStart="16dp"
                android:minWidth="80dp" />
        </LinearLayout>

        <!-- Focus Distance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus Distance:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <SeekBar
                android:id="@+id/focusDistanceSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/focusDistanceValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Focus"
                android:layout_marginStart="16dp"
                android:minWidth="100dp" />
        </LinearLayout>

        <!-- Sensor Status Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connected Sensors"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:padding="8dp" />

        <TextView
            android:id="@+id/gsrSensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GSR Sensor: Checking..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/thermalCameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thermal Camera: Checking..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/rgbCameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RGB Camera: Available"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/audioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio Recording: Checking..."
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="#F5F5F5" />

        <!-- Folder Access Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Folder Access"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Output Folder:"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/outputFolderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/storage/emulated/0/DCIM/GSRCapture"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:maxLines="3"
            android:ellipsize="middle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/selectFolderButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Folder"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/openFolderButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open Folder"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>