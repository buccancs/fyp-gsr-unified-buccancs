<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sensor Status Panel -->
    <LinearLayout
        android:id="@+id/sensorStatusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <!-- GSR Status -->
        <TextView
            android:id="@+id/gsrStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gsr_value"
            android:textColor="@color/colorWhite"
            android:textSize="14sp" />

        <!-- Heart Rate (if available) -->
        <TextView
            android:id="@+id/heartRateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_rate"
            android:textColor="@color/colorWhite"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Camera Type Indicator -->
        <TextView
            android:id="@+id/cameraTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rgb_camera"
            android:textColor="@color/colorWhite"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Capture Stage Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture Stage:"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/captureStageRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/stage1RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 1 - RAW"
                android:textColor="@color/colorWhite"
                android:textSize="11sp"
                android:buttonTint="@color/colorWhite" />

            <RadioButton
                android:id="@+id/stage3RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 3 - YUV"
                android:textColor="@color/colorWhite"
                android:textSize="11sp"
                android:buttonTint="@color/colorWhite"
                android:checked="true" />

        </RadioGroup>

        <!-- Recording Status -->
        <TextView
            android:id="@+id/recordingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textColor="@color/colorSuccess"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Sensor Toggle Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensors:"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <!-- RGB Video Toggle -->
        <CheckBox
            android:id="@+id/rgbVideoCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RGB Video"
            android:textColor="@color/colorWhite"
            android:textSize="11sp"
            android:buttonTint="@color/colorWhite"
            android:checked="true"
            android:layout_marginTop="2dp" />

        <!-- Thermal Video Toggle -->
        <CheckBox
            android:id="@+id/thermalVideoCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thermal Video"
            android:textColor="@color/colorWhite"
            android:textSize="11sp"
            android:buttonTint="@color/colorWhite"
            android:checked="true"
            android:layout_marginTop="2dp" />

        <!-- GSR Sensor Toggle -->
        <CheckBox
            android:id="@+id/gsrSensorCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GSR Sensor"
            android:textColor="@color/colorWhite"
            android:textSize="11sp"
            android:buttonTint="@color/colorWhite"
            android:checked="true"
            android:layout_marginTop="2dp" />

        <!-- Audio Recording Toggle -->
        <CheckBox
            android:id="@+id/audioRecordingCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Recording"
            android:textColor="@color/colorWhite"
            android:textSize="11sp"
            android:buttonTint="@color/colorWhite"
            android:checked="true"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Controls Layout -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Settings Button -->
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:layout_marginEnd="4dp" />

        <!-- Camera Switch Button -->
        <Button
            android:id="@+id/cameraSwitchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/switch_camera"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Record Button -->
        <Button
            android:id="@+id/recordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_recording"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
